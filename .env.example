# AI Correction Endpoints
# Set these to your deployed Cloudflare Worker URL to enable live correction.
# If empty, the frontend shows a safe fallback.
#
# Writing correction endpoint
# VITE_AI_CORRECTION_ENDPOINT=https://deutsch-klinik-ai-correction.deutsch-klinik.workers.dev
VITE_AI_CORRECTION_ENDPOINT=

# Speaking feedback endpoint
# If not set, falls back to VITE_AI_CORRECTION_ENDPOINT if that is configured.
# VITE_AI_SPEAKING_ENDPOINT=https://deutsch-klinik-ai-correction.deutsch-klinik.workers.dev
VITE_AI_SPEAKING_ENDPOINT=
