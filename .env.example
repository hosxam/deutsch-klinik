# Supabase configuration for cloud sync
# Get these from your Supabase project dashboard:
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare AI Worker (unified endpoint for all AI features)
# Deploy workers/ai-worker first, then set this URL:
#   cd workers/ai-worker && npx wrangler deploy
# The Worker handles writing correction, speaking feedback, transcription, and TTS.
VITE_AI_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# Legacy AI endpoints (fallback, kept for backward compatibility)
# These are used if VITE_AI_WORKER_URL is not set.
VITE_AI_CORRECTION_ENDPOINT=
VITE_AI_SPEAKING_ENDPOINT=
VITE_CLOUDFLARE_AI_ENDPOINT=
