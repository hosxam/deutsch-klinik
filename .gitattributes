# Auto-detect text files and normalize to LF
* text=auto

# JSON files - normalize to LF
*.json text eol=lf

# JavaScript/JSX files
*.js text eol=lf
*.jsx text eol=lf
*.cjs text eol=lf

# HTML/CSS
*.html text eol=lf
*.css text eol=lf

# Markdown
*.md text eol=lf

# Config files
*.yml text eol=lf
*.yaml text eol=lf
*.config.* text eol=lf
