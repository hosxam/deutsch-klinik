{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deutsch Klinik Progress Schema",
  "description": "Data model for tracking user progress in Deutsch Klinik C1 Trainer",
  "type": "object",
  "properties": {
    "currentLevel": {
      "type": "string",
      "enum": ["A1", "A2", "B1", "B2", "C1"],
      "description": "The level the user is currently working on"
    },
    "theme": {
      "type": "string",
      "enum": ["dark", "light"],
      "description": "UI theme preference"
    },
    "streak": {
      "type": "object",
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "lastDate": { "type": ["string", "null"], "format": "date" }
      },
      "required": ["count", "lastDate"]
    },
    "levels": {
      "type": "object",
      "patternProperties": {
        "^(A1|A2|B1|B2|C1)$": {
          "type": "object",
          "properties": {
            "grammar": { "type": "array", "items": { "type": "object" } },
            "vocab": { "type": "array", "items": { "type": "object" } },
            "quizzes": { "type": "array", "items": { "type": "object" } },
            "listening": { "type": "array", "items": { "type": "object" } },
            "reading": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    },
    "exams": {
      "type": "object",
      "patternProperties": {
        "^(A1|A2|B1|B2|C1)$": {
          "type": "object",
          "properties": {
            "passed": { "type": "boolean" },
            "score": { "type": "number", "minimum": 0, "maximum": 100 },
            "date": { "type": "string", "format": "date" }
          },
          "required": ["passed", "score", "date"]
        }
      }
    },
    "writings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "level": { "type": "string" },
          "prompt": { "type": "string" },
          "text": { "type": "string" },
          "date": { "type": "string", "format": "date-time" },
          "score": { "type": "number" }
        },
        "required": ["id", "level", "prompt", "text", "date"]
      }
    },
    "flashcards": {
      "type": "object",
      "description": "SM-2 spaced repetition state per word ID",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "ease": { "type": "number", "minimum": 1.3, "maximum": 3.0 },
            "interval": { "type": "integer", "minimum": 0 },
            "due": { "type": "string", "format": "date" },
            "repetitions": { "type": "integer", "minimum": 0 }
          },
          "required": ["ease", "interval", "due", "repetitions"]
        }
      }
    },
    "completedLessons": {
      "type": "object",
      "description": "Lesson IDs completed per level",
      "patternProperties": {
        "^(A1|A2|B1|B2|C1)$": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "incorrectAnswers": {
      "type": "object",
      "description": "Incorrect answers recorded per level",
      "patternProperties": {
        "^(A1|A2|B1|B2|C1)$": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "exerciseId": { "type": "string" },
              "userAnswer": { "type": "string" },
              "correctAnswer": { "type": "string" },
              "topic": { "type": "string" },
              "date": { "type": "string" }
            }
          }
        }
      }
    },
    "repeatedMistakes": {
      "type": "object",
      "description": "Mistakes that have occurred multiple times",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "topic": { "type": "string" },
            "count": { "type": "integer" },
            "lastDate": { "type": "string" },
            "level": { "type": "string" }
          }
        }
      }
    },
    "mistakeNotebook": {
      "type": "object",
      "description": "Detailed mistake records for review",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "topic": { "type": "string" },
            "userAnswer": { "type": "string" },
            "correctAnswer": { "type": "string" },
            "level": { "type": "string" },
            "date": { "type": "string" },
            "repeated": { "type": "integer" }
          }
        }
      }
    },
    "vocabularyMastery": {
      "type": "object",
      "description": "Mastery tracking per word with SM-2 state",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "correct": { "type": "integer" },
            "incorrect": { "type": "integer" },
            "mastered": { "type": "boolean" },
            "ease": { "type": "number" },
            "interval": { "type": "integer" },
            "due": { "type": "string" },
            "repetitions": { "type": "integer" }
          }
        }
      }
    },
    "grammarMastery": {
      "type": "object",
      "description": "Mastery tracking per grammar exercise",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "correct": { "type": "integer" },
            "incorrect": { "type": "integer" },
            "mastered": { "type": "boolean" }
          }
        }
      }
    },
    "readinessScores": {
      "type": "object",
      "description": "C1 readiness assessment scores",
      "properties": {
        "reading": { "type": "number", "minimum": 0, "maximum": 100 },
        "listening": { "type": "number", "minimum": 0, "maximum": 100 },
        "writing": { "type": "number", "minimum": 0, "maximum": 100 },
        "speaking": { "type": "number", "minimum": 0, "maximum": 100 },
        "grammar": { "type": "number", "minimum": 0, "maximum": 100 },
        "vocabulary": { "type": "number", "minimum": 0, "maximum": 100 },
        "timeManagement": { "type": "number", "minimum": 0, "maximum": 100 },
        "overall": { "type": "number", "minimum": 0, "maximum": 100 },
        "completed": { "type": "boolean" },
        "lastUpdated": { "type": ["string", "null"] }
      }
    },
    "topicWeakness": {
      "type": "object",
      "description": "Topic-specific weakness tracking",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "correct": { "type": "integer" },
            "incorrect": { "type": "integer" },
            "status": { "type": "string", "enum": ["weak", "improving", "mastered"] }
          }
        }
      }
    },
    "listeningCompleted": {
      "type": "object",
      "description": "Completed listening exercises per level",
      "patternProperties": {
        "^(A1|A2|B1|B2|C1)$": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "readingCompleted": {
      "type": "object",
      "description": "Completed reading exercises per level",
      "patternProperties": {
        "^(A1|A2|B1|B2|C1)$": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "medicalUnlocked": { "type": "boolean" },
    "placementResult": { "type": ["object", "null"] },
    "weakAreas": {
      "type": "object",
      "description": "Flagged weak areas per level"
    }
  }
}
